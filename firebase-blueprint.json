{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile details",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID from Firebase Authentication"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "Avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile update"
        }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "TreeDocument": {
      "title": "TreeDocument",
      "description": "A family tree owned by a user or publicly shared",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique tree ID"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the user who owns this tree"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the owner displayed on public trees"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Title of the family tree"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Optional description of the family tree"
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether anyone can view this tree with the link"
        },
        "personCount": {
          "type": "number",
          "description": "Count of persons in the tree"
        },
        "treeDataJson": {
          "type": "string",
          "description": "Serialized JSON string of FamilyTreeData"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "ownerId", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles with owner-only access"
    },
    "/trees/{treeId}": {
      "schema": "TreeDocument",
      "description": "Stores user family trees with owner write and optional public read access"
    }
  }
}
